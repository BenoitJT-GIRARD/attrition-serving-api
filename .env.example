# ----------------------------
# Attrition serving — Example env file
# Copy to .env.local (local) or configure as Secrets (Hugging Face)
# ----------------------------

# --- API security ---
# Required header: X-API-Key: <API_KEY>
API_KEY=change_me

# --- Database ---
# Local docker-compose default (PostgreSQL)
DATABASE_URL=postgresql+psycopg://attrition:attrition_pwd@localhost:5432/attrition_serving

# Supabase example (enable SSL)
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# --- Model serving ---
# MODEL_THRESHOLD overrides the operating point recorded in models/model_card.json.
# Leave it unset to serve the threshold the model was exported with. It used to be set to
# 0.5 here, which is neither the documented threshold nor a value anything justified.
MODEL_THRESHOLD=
MODEL_VERSION=local-dev

# --- Misc / reproducibility ---
RANDOM_STATE=42
ANONYMIZATION_KEY=change_me

# Only for tests (do not set in prod unless you know why)
SKIP_DOTENV=1

# --- Where the extracts live ---
# The three raw CSVs and everything derived from them. Left unset they live under `data/` in
# the checkout; set it to keep a dataset off a synchronised drive, which is what the author's
# own machine does. docs/data-source.md says what belongs there.
ATTRITION_DATA_DIR=

# --- Which deployment file to load on top of .env ---
# Read by src/attrition_serving/env.py. Defaults to .env.local; set it to .env.docker when
# running the container against a different database. SKIP_DOTENV=1 disables both, which is
# what the CI and the test suite set.
ENV_FILE=.env.local
SKIP_DOTENV=

# --- The database, spelled out ---
# `scripts/load_raw_to_postgres.py` accepts the connection as five parts instead of one URL,
# because that is how a managed database hands out its credentials. DATABASE_URL above wins
# when it is set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attrition_serving
DB_USER=attrition
DB_PASSWORD=

# --- Taking the screenshots ---
# scripts/capture.py drives a real browser. Set this when Chrome is not on PATH.
CHROME_PATH=

# --- The database the integration tier talks to ---
# Left unset the tier uses DATABASE_URL. Set it to point the tests at a throwaway database
# instead of the one a demonstration is running against.
TEST_DATABASE_URL=
