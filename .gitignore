# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.vscode/
.DS_Store

# Virtual environments
.venv

# The extracts, and everything derived from them. docs/data-source.md says what they are and
# how to put them back. Only the contents are ignored. No file under data/ is tracked, so a
# clone has no data/ directory until scripts/build_extracts.py writes one.
data/raw/*
data/processed/*

# MLflow / artifacts
mlruns/
artifacts/

# Notebooks checkpoints
.ipynb_checkpoints/

# Env
.env
.env.local
.env.supabase
.env.docker

# Coverage reports. reports/coverage/coverage.xml IS published: the badge recomputes from it.
var/
.coverage
htmlcov/
reports/coverage_html/
